<?xml version="1.0" encoding="UTF-8"?>
<!--
  What `mvn archetype:generate` asks for, and what it writes.

  THE FOUR REQUIRED PROPERTIES ARE THE WHOLE INTERFACE, so each has a default that produces a working
  project. An archetype that stops to ask a question a beginner cannot answer is worse than one that guesses:
  the guess is visible in the generated files and can be edited, an unanswered prompt is a dead end.

  `filtered="true"` runs a file through Velocity, which is what substitutes ${package} and the versions. It
  is on for every text file here — including .gitignore and the META-INF/services declaration, whose whole
  content is a fully-qualified class name that must follow the chosen package.
-->
<archetype-descriptor xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
                      name="botmaker-plugin"
                      partial="false">

    <requiredProperties>
        <!--
          The plugin's id: what StudioPlugin.id() returns, and the name the plugin registry refuses to admit
          twice. It is NOT the Maven coordinate — a plugin may be re-published under a new coordinate and
          must keep its id, because that id is what a project's stored data refers to.
        -->
        <requiredProperty key="pluginId">
            <defaultValue>${groupId}</defaultValue>
        </requiredProperty>

        <!-- What Studio shows in Manage Plugins. Free text. -->
        <requiredProperty key="pluginName">
            <defaultValue>${artifactId}</defaultValue>
        </requiredProperty>

        <!--
          The two BotMaker versions written into the generated pom. `main-SNAPSHOT` is a real JitPack
          coordinate — it builds the tip of that repository's main branch — and it is the default because it
          never goes stale. Pass a released tag (e.g. -DstudioApiVersion=v1.0.0) for anything you intend to
          publish; the generated README says so too.
        -->
        <requiredProperty key="studioApiVersion">
            <defaultValue>main-SNAPSHOT</defaultValue>
        </requiredProperty>
        <requiredProperty key="toolkitVersion">
            <defaultValue>main-SNAPSHOT</defaultValue>
        </requiredProperty>
    </requiredProperties>

    <fileSets>
        <!-- The Java sources, under the chosen package; api/, plugin/types/ … keep their subdirectory. -->
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <!--
          NOT packaged: META-INF/services is a fixed path, and the file NAME is the contract interface's
          fully-qualified name. Filtered, because its one line is ${package}.plugin.ExamplePlugin.
        -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <!--
          Project root: the README that says what to do next. DELIBERATELY NOT FILTERED.

          `##` is Velocity's single-line comment, so every level-2 markdown heading in a filtered README is
          silently eaten along with the rest of its line. Rather than write a README in a subset of markdown
          to keep a templating engine happy, this one names nothing project-specific and is copied verbatim.

          THERE IS NO .gitignore HERE, and that is a limit of the tool rather than a choice. `archetype:jar`
          packages archetype-resources through a Plexus archiver with default excludes on, and that list
          holds `**/.gitignore`: the file reaches target/classes and is dropped from the jar with no warning.
          The workarounds all end with a generated project holding a file named something other than
          .gitignore, which is worse than none. The generated README asks for one instead.
        -->
        <fileSet encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>README.md</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
