<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      THE PARENT — what this plugin builds against, as one version. It pins the contract, the toolkit and JavaFX
      together, sets Java 25, and flattens the pom this plugin publishes: the pins written out, the parent
      dropped, and <properties> kept, so the published pom still names the plugin class. Move it, and the
      contract and toolkit move with it. To build against another contract or toolkit than it pins, set
      botmaker.studioapi.version or botmaker.plugintoolkit.version in <properties> below.

      Its version is this repository's like any pin (umbrella docs/refactor/43-real-versions.md): the parent's
      -SNAPSHOT on main, read from the umbrella checkout beside this one; its released tag on a tag, resolved
      from JitPack through the repository below.
    -->
    <parent>
        <groupId>com.github.BotMakerDev</groupId>
        <artifactId>botmaker-plugin-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath>../botmaker-plugin-parent/pom.xml</relativePath>
    </parent>

    <!-- botmaker plugin new: coordinates -->
    <!--
      THIS POM IS TWO THINGS. It builds the example plugin in this repository, and it is the pom a new plugin
      starts with: `botmaker plugin new` copies it, replacing the region marked `coordinates` with the new
      plugin's own and deleting the region marked `drop`. Everything else reaches the new plugin as written,
      so everything else is what a plugin's pom should say. CI builds and tests it here, which is the point:
      the skeleton a newcomer gets is a project that compiled.

      Its upstream versions are this repository's like any other module's: each upstream's -SNAPSHOT on main,
      its released tag on a tag (umbrella docs/refactor/43-real-versions.md). So a plugin made by a released
      `botmaker` pins the contract and toolkit that were released with it.
    -->
    <groupId>com.github.BotMakerDev</groupId>
    <artifactId>botmaker-plugin-archetype</artifactId>
    <version>0.6.1-SNAPSHOT</version>

    <!-- The name Studio shows for the plugin. -->
    <name>Greeter</name>
    <description>
        The example plugin `botmaker plugin new` copies: a value type, a palette block and a managed value,
        built and tested as they stand.
    </description>
    <!-- /botmaker plugin new -->

    <properties>
        <!--
          The plugin class this jar is. Studio reads it off the pom Maven copies into the jar
          (META-INF/maven/<groupId>/<artifactId>/pom.xml), so it must be the literal class name: this pom's
          groupId:artifactId is the plugin's identity and its <name> what Studio shows. Rename or move the
          class and change it here.
        -->
        <botmaker.plugin>com.example.greetings.plugin.ExamplePlugin</botmaker.plugin>
    </properties>

    <repositories>
        <!-- BotMaker's modules are published through JitPack, which serves each git tag as
             com.github.BotMakerDev:<repo>:<tag>. Maven finds the parent above through it too, so it is
             declared here and not in the parent. -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          THE CONTRACT — what this plugin implements. `compile`, because a bot needs it too: the welcome
          parameter Studio writes into a bot carries `@Param` and `@GreetValue`, whose `@ManagedMarker` is a
          contract class. Studio loads the contract parent-first, so a plugin's copy is never a second set of
          classes. A plugin that never marks a bot's code (no level 3) may make this `provided`.
        -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-studio-api</artifactId>
        </dependency>

        <!--
          THE WIDGETS — what this plugin compiles against. Ordinary `compile` scope, and that too is
          deliberate: the toolkit is resolved onto YOUR plugin's classloader, so your version is yours and no
          other plugin's. Do not mark it `provided`; Studio does not have it.
        -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-plugin-toolkit</artifactId>
        </dependency>

        <!--
          JavaFX, `provided` (the parent says so): a slot editor draws into the host's scene graph, and a second
          toolkit in a process that already has one does not work.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- botmaker plugin new: drop -->
            <!--
              The skeleton `botmaker plugin new` copies, as a second artifact (classifier `template`, a zip):
              this pom, src/main, src/test, the README in src/template, and .gitignore stored as `gitignore`.
              botmaker-cli bundles the zip at its build; the cli names the dot back on copy, because a jar's
              default excludes drop a `.gitignore` with no warning (the reason the maven-archetype packaging
              this module had until 2026-10-19 could never ship one).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>template</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/template.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- /botmaker plugin new -->
        </plugins>
    </build>
</project>
