<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- botmaker plugin new: coordinates -->
    <!--
      THIS POM IS TWO THINGS. It builds the example plugin in this repository, and it is the pom a new plugin
      starts with: `botmaker plugin new` copies it, replacing the region marked `coordinates` with the new
      plugin's own and deleting the region marked `drop`. Everything else reaches the new plugin as written,
      so everything else is what a plugin's pom should say. CI builds and tests it here, which is the point:
      the skeleton a newcomer gets is a project that compiled.

      Its upstream versions are this repository's like any other module's: each upstream's -SNAPSHOT on main,
      its released tag on a tag (umbrella docs/refactor/43-real-versions.md). So a plugin made by a released
      `botmaker` pins the contract and toolkit that were released with it.
    -->
    <groupId>com.github.BotMakerDev</groupId>
    <artifactId>botmaker-plugin-archetype</artifactId>
    <version>0.5.0</version>

    <name>BotMaker Plugin Archetype</name>
    <description>
        The example plugin `botmaker plugin new` copies: a value type, a palette block and a managed value,
        built and tested as they stand.
    </description>
    <!-- /botmaker plugin new -->

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Released tags (`v0.10.0`), which JitPack serves as com.github.BotMakerDev:<repo>:<tag>. Move them when
          Studio moves: a plugin loads in any Studio whose contract has every member it uses, so build against
          the oldest contract you mean to support. A `-SNAPSHOT` here resolves from your own ~/.m2 only.
        -->
        <botmaker.studioapi.version>v0.12.0</botmaker.studioapi.version>
        <botmaker.plugintoolkit.version>v0.11.0</botmaker.plugintoolkit.version>
    </properties>

    <repositories>
        <!-- BotMaker's modules are published through JitPack, which serves each git tag as
             com.github.BotMakerDev:<repo>:<tag>. -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          THE CONTRACT — what this plugin implements. `compile`, because a bot needs it too: the welcome
          parameter Studio writes into a bot carries `@Param` and `@GreetValue`, whose `@ManagedMarker` is a
          contract class. Studio loads the contract parent-first, so a plugin's copy is never a second set of
          classes. A plugin that never marks a bot's code (no level 3) may make this `provided`.
        -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-studio-api</artifactId>
            <version>${botmaker.studioapi.version}</version>
        </dependency>

        <!--
          THE WIDGETS — what this plugin compiles against. Ordinary `compile` scope, and that too is
          deliberate: the toolkit is resolved onto YOUR plugin's classloader, so your version is yours and no
          other plugin's. Do not mark it `provided`; Studio does not have it.
        -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-plugin-toolkit</artifactId>
            <version>${botmaker.plugintoolkit.version}</version>
        </dependency>

        <!--
          JavaFX, `provided`: a slot editor draws into the host's scene graph, and a second toolkit in a process
          that already has one does not work.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>27</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- botmaker plugin new: drop -->
            <!--
              The skeleton `botmaker plugin new` copies, as a second artifact (classifier `template`, a zip):
              this pom, src/main, src/test, the README in src/template, and .gitignore stored as `gitignore`.
              botmaker-cli bundles the zip at its build; the cli names the dot back on copy, because a jar's
              default excludes drop a `.gitignore` with no warning (the reason the maven-archetype packaging
              this module had until 2026-10-19 could never ship one).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>template</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/template.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- /botmaker plugin new -->
        </plugins>
    </build>
</project>
